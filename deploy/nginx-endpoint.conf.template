# Nginx site template for the Endpoint Management server.
#
# install-ubuntu.sh substitutes the placeholders below:
#   __DOMAIN__   -> the public hostname, e.g. mgmt.example.com
#   __SSL_DIR__  -> the certificate directory, e.g. /etc/ssl/endpoint-mgmt
#
# To install by hand, copy this file, replace the placeholders, and point
# /etc/nginx/sites-enabled at it.
#
# Handles three things: the REST API, the embedded Web Console SPA, and the
# long-lived WebSocket channels used by agents and interactive sessions.

upstream endpoint_backend {
    server 127.0.0.1:8443;
    keepalive 64;
}

# Redirect plain HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location / {
        return 301 https://$host$request_uri;
    }
}

# Main HTTPS & WSS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    # Certificate paths. A wildcard certificate may be copied to this name.
    ssl_certificate     __SSL_DIR__/__DOMAIN__.fullchain.crt;
    ssl_certificate_key __SSL_DIR__/__DOMAIN__.key;

    # TLS 1.2 and 1.3 only
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Large package uploads (software deployment and agent releases)
    client_max_body_size 1024M;
    client_body_buffer_size 128k;

    # REST API and Web Console SPA
    location / {
        proxy_pass http://endpoint_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Persistent WebSocket channels:
    #   /api/agent/connect                 outbound agent socket
    #   /api/devices/{id}/terminal/ws      interactive remote shell
    #   /api/devices/{id}/remotecontrol/ws remote control screen relay
    #   /api/agent/devices/{id}/remotecontrol/ws  agent side of the relay
    location ~* ^/api/(agent/connect|agent/devices/.*/remotecontrol/ws|devices/.*/(terminal|remotecontrol)/ws) {
        proxy_pass http://endpoint_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # No buffering, 24h timeouts: agent sockets are expected to stay open.
        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
